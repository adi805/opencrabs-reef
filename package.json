{
  "name": "opencrabs-reef",
  "private": true,
  "version": "0.3.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "reef": "node server/crabsPoll.mjs",
    "reef:serve": "node server/reefServer.mjs",
    "verify:map": "node scripts/verify-toolmap.mjs",
    "shot": "node scripts/reef-shot.mjs",
    "typecheck": "tsc -b",
    "test:contracts": "node tests/verify-poller-privacy.mjs && node tests/verify-server-contract.mjs",
    "test": "npm run test:contracts && npm run build && npm run verify:characters && npm run verify:textures",
    "verify:characters": "node scripts/verify-characters.mjs && node scripts/verify-motion.mjs",
    "verify:textures": "node scripts/verify-textures.mjs",
    "verify:world": "node scripts/verify-world.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "playwright": "^1.55.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
